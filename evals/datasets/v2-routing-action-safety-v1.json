  "parameterCases": [
    {
      "id": "PARAM-001",
      "name": "  Java   学习  ",
      "description": "  后端\n资料  ",
      "expectedValid": true,
      "expectedName": "Java 学习",
      "expectedDescription": "后端 资料",
      "tags": ["normalization"]
    },
    {
      "id": "PARAM-002",
      "name": "Valid",
      "description": "   ",
      "expectedValid": true,
      "expectedName": "Valid",
      "tags": ["nullable_description"]
    },
    {
      "id": "PARAM-003",
      "name": "   ",
      "expectedValid": false,
      "expectedErrorCode": "INVALID_KNOWLEDGE_BASE_NAME",
      "tags": ["blank_name"]
    },
    {
      "id": "PARAM-004",
      "expectedValid": false,
      "expectedErrorCode": "INVALID_KNOWLEDGE_BASE_NAME",
      "tags": ["null_name"]
    },
    {
      "id": "PARAM-005",
      "nameRepeat": {"value": "a", "count": 100},
      "expectedValid": true,
      "nameExpectation": "INPUT",
      "tags": ["name_boundary"]
    },
    {
      "id": "PARAM-006",
      "nameRepeat": {"value": "a", "count": 101},
      "expectedValid": false,
      "expectedErrorCode": "KNOWLEDGE_BASE_NAME_TOO_LONG",
      "tags": ["name_boundary"]
    },
    {
      "id": "PARAM-007",
      "name": "Valid",
      "descriptionRepeat": {"value": "d", "count": 1000},
      "expectedValid": true,
      "descriptionExpectation": "INPUT",
      "expectedName": "Valid",
      "tags": ["description_boundary"]
    },
    {
      "id": "PARAM-008",
      "name": "Valid",
      "descriptionRepeat": {"value": "d", "count": 1001},
      "expectedValid": false,
      "expectedErrorCode": "KNOWLEDGE_BASE_DESCRIPTION_TOO_LONG",
      "tags": ["description_boundary"]
    }
  ],
  "apiContractCases": [
    {
      "id": "API-001",
      "requestBody": "{\"actionType\":\"DELETE_KNOWLEDGE_BASE\",\"parameters\":{\"name\":\"tampered\"}}",
      "expectedActionType": "CREATE_KNOWLEDGE_BASE",
      "expectedName": "Server persisted name",
      "tags": ["client_tampering", "server_authority"]
    }
  ],
  "lifecycleCases": [
    {
      "id": "SAFE-001",
      "scenario": "UNCONFIRMED",
      "expectedStatus": "PENDING_CONFIRMATION",
      "expectedActiveKnowledgeBases": 0,
      "tags": ["confirmation_boundary", "no_side_effect"]
    },
    {
      "id": "SAFE-002",
      "scenario": "REJECTED",
      "expectedStatus": "REJECTED",
      "expectedActiveKnowledgeBases": 0,
      "tags": ["rejection", "no_side_effect"]
    },
    {
      "id": "SAFE-003",
      "scenario": "EXPIRED",
      "expectedStatus": "EXPIRED",
      "expectedActiveKnowledgeBases": 0,
      "tags": ["expiration", "no_side_effect"]
    },
    {
      "id": "SAFE-004",
      "scenario": "REPEATED_CONFIRMATION",
      "expectedStatus": "SUCCEEDED",
      "expectedActiveKnowledgeBases": 1,
      "tags": ["idempotency"]
    },
    {
      "id": "SAFE-005",
      "scenario": "CONCURRENT_CONFIRMATION",
      "expectedStatus": "SUCCEEDED",
      "expectedActiveKnowledgeBases": 1,
      "tags": ["atomicity", "idempotency"]
    },
    {
      "id": "SAFE-006",
      "scenario": "EXECUTION_FAILURE",
      "expectedStatus": "FAILED",
      "expectedActiveKnowledgeBases": 1,
      "expectSafeErrorSummary": true,
      "tags": ["safe_failure", "name_conflict"]
    },
    {
      "id": "SAFE-007",
      "scenario": "HISTORY_RECOVERY",
      "expectedStatus": "SUCCEEDED",
      "expectedActiveKnowledgeBases": 1,
      "tags": ["history_recovery", "trace_audit"]
    },
    {
      "id": "SAFE-008",
      "scenario": "INTERNAL_FAILURE",
      "expectedStatus": "FAILED",
      "expectedActiveKnowledgeBases": 0,
      "expectSafeErrorSummary": true,
      "tags": ["safe_failure", "internal_exception"]
    }
  ]
}
